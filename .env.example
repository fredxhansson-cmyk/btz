# ---------------------------------------------------------------------------
# BTZ — auth & billing. Copy to .env.local (dev) and add the same vars in the
# Vercel project settings (Production). Without these, BTZ runs fully as before
# (no login, everything unlocked locally).
# ---------------------------------------------------------------------------

# Auth — Clerk (https://dashboard.clerk.com)
#  1. Create an application. Under "User & Authentication" enable
#     Email + Password AND Google (Social Connections).
#  2. Copy the API keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Billing — Stripe (https://dashboard.stripe.com)
#  1. Create products/prices: Pro (recurring $4/mo & $29/yr) and Lifetime ($79 one-time).
#  2. Add the price IDs + keys here. Webhook: point Stripe at /api/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
